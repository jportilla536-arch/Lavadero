# ===============================================================
#  Lavadero SaaS · Backend
#  Plantilla. Copia este archivo como .env y rellena los valores.
#  NUNCA pongas claves reales aquí: este archivo se versiona en git.
#
#  El backend accede a los datos solo por la API de Supabase.
#  No se necesita cadena de conexión de PostgreSQL.
# ===============================================================

# ---------------------------------------------------------------
# Supabase · datos y Storage
# Dashboard > Project Settings > API
# La service role key es secreta: ignora las políticas RLS.
# ---------------------------------------------------------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="lavadero"

# supabase | local  ("local" guarda las imágenes en backend/uploads)
STORAGE_DRIVER=supabase

# ---------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
PUBLIC_URL="http://localhost:4000"

# ---------------------------------------------------------------
# Autenticación JWT
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ---------------------------------------------------------------
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------
# Usuario administrador inicial (seed)
# ---------------------------------------------------------------
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@lavadero.com"
SEED_ADMIN_PASSWORD="cambia-esta-contrasena"
